      "specialist_id": "specialist-request-extraction-rejection-and-body-parsing",
      "concern": "Request extraction, rejection, and body parsing",
      "one_line": "Owns conversion of requests into typed extractor values while enforcing ordering, content types, body limits, and typed rejections.",
